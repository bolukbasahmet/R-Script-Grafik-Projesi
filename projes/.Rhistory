getwd()
library(tidyverse)
insurance_df <- read_csv("insurance.csv")
head(insurance_df)
glimpse(insurance_df)
summary(insurance_df)
df <- insurance_df
erkek <- df[df$sex == "male", ]
View(erkek)
table(df$sex)
Kadin <- df[df$sex == "female", ]
View(Kadin)
table(df$sex)
colSums(is.na(df))
plot_age_hist <- ggplot(df, aes(x = age)) +
geom_histogram(binwidth = 5,
fill = "blue",
color = "white",
alpha = 0.8) +
labs(title = "Yaş Dağılımı",
x = "Yaş",
y = "Kişi Sayısı") +
theme_light()
plot_age_hist
plot_bmi_hist <- ggplot(df, aes(x = bmi)) +
geom_histogram(binwidth = 2,
fill = "red",
color = "white",
alpha = 0.8) +
labs(title = "Vücut Kitle Endeksi (BMI) Dağılımı",
x = "BMI Değeri",
y = "Kişi Sayısı") +
theme_light()
plot_bmi_hist
plot_children_hist <- ggplot(df, aes(x = children)) +
geom_histogram(binwidth = 1,
fill = "darkgreen",
color = "black",
alpha = 0.7) +
labs(title = "Çocuk Sayısı Dağılımı",
x = "Çocuk Sayısı",
y = "Kişi Sayısı") +
theme_light()
plot_children_hist
plot_expenses_hist <- ggplot(df, aes(x = expenses)) +
geom_histogram(bins = 30,
fill = "darkgreen",
color = "black",
alpha = 0.7) +
labs(title = "Maliyet Dağılımı",
x = "Maliyet (USD)",
y = "Kişi Sayısı") +
theme_light()
print(plot_expenses_hist)
if(!require(patchwork)) install.packages("patchwork")
library(patchwork)
(plot_age_hist + plot_bmi_hist) / (plot_children_hist + plot_expenses_hist)
